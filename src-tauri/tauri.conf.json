{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "Cryptography Playground",
    "version":  "0.1.0",
    "identifier":  "com.zevarix.cryptographyplayground",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Cryptography Playground",
                                    "width":  1280,
                                    "height":  820,
                                    "minWidth":  840,
                                    "minHeight":  620
                                }
                            ],
                "security":  {
                                 "csp": {
                                   "default-src": "'none'",
                                   "script-src": "'self'",
                                   "script-src-attr": "'none'",
                                   "style-src": "'self'",
                                   "style-src-attr": "'none'",
                                   "img-src": "'self'",
                                   "font-src": "'none'",
                                   "connect-src": "ipc: http://ipc.localhost",
                                   "object-src": "'none'",
                                   "base-uri": "'none'",
                                   "form-action": "'none'",
                                   "frame-src": "'none'",
                                   "worker-src": "'none'"
                                 },
                                 "devCsp": {
                                   "default-src": "'none'",
                                   "script-src": "'self' 'unsafe-inline'",
                                   "script-src-attr": "'none'",
                                   "style-src": "'self' 'unsafe-inline'",
                                   "style-src-attr": "'none'",
                                   "img-src": "'self'",
                                   "font-src": "'none'",
                                   "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1421 ws://127.0.0.1:1421",
                                   "object-src": "'none'",
                                   "base-uri": "'none'",
                                   "form-action": "'none'",
                                   "frame-src": "'none'",
                                   "worker-src": "'none'"
                                 }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ]
               }
}